[Unit]
Description=Screen anomaly monitor (camera + device screencast)
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/Camera-Algorithm
# 飞书凭证等敏感配置放这里，不进 git；文件不存在也不影响启动
EnvironmentFile=-%h/.config/screen-monitor.env
ExecStart=%h/Camera-Algorithm/.venv/bin/python3 -u %h/Camera-Algorithm/web_monitor.py --screens 3 --port 8000 --types black_screen,screen_distorted,screen_flicking
# 白平衡、曝光、增益由服务启动时自动标定（见 camera_diag.calibrate_camera），
# 这里只补标定不涉及的锐化。sleep 30 是为了落在标定之后，否则会打断标定取样。
# sharpness=7 实测清晰度 +40%，零代价；内核在设备 open 时会把控制项复位成默认，
# 所以必须在服务起来之后再写。
ExecStartPost=/bin/sh -c "sleep 30; /usr/bin/v4l2-ctl -d /dev/video0 -c sharpness=7 || true"
Restart=always
RestartSec=5
# 相机被 USB 重新枚举后 index 会变，这里不写死 --device，交给启动时自动诊断
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
